tsem:{"event":"begin","element":"ltx:ref","attrs":{"labelref":"eq:quad"}}
tsem:{"event":"end","element":"ltx:ref"}
tsem:{"event":"text","text":" is rendered as display math. See Section "}
tsem:{"event":"begin","element":"ltx:ref","attrs":{"labelref":"sec:overview"}}
tsem:{"event":"end","element":"ltx:ref"}
tsem:{"event":"text","text":" for the introduction."}
