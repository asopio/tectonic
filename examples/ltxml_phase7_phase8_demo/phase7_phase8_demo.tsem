tsem:{"event":"begin","element":"ltx:section","attrs":{"xml:id":"S1","labels":"LABEL:sec:overview","refnum":"1"}}
tsem:{"event":"begin","element":"ltx:title"}
tsem:{"event":"text","text":"Overview"}
tsem:{"event":"end","element":"ltx:title"}
tsem:{"event":"begin","element":"ltx:p"}
tsem:{"event":"text","text":"This prototype HTML output was compiled with the "}
tsem:{"event":"begin","element":"ltx:emph"}
tsem:{"event":"text","text":"atlas"}
tsem:{"event":"end","element":"ltx:emph"}
tsem:{"event":"text","text":" output profile. It exercises graphics normalization, table normalization, references, and MathJax profile settings."}
tsem:{"event":"end","element":"ltx:p"}
tsem:{"event":"end","element":"ltx:section"}
tsem:{"event":"begin","element":"ltx:section","attrs":{"xml:id":"S2","labels":"LABEL:sec:math","refnum":"2"}}
